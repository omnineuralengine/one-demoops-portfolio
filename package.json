{
  "name": "one-demoops-control-plane",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Independent synthetic DemoOps systems portfolio built with ONE.",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:foundry": "vitest run tests/scenario-foundry tests/ui/scenario-foundry-keyboard.test.tsx",
    "test:e2e": "playwright test",
    "docs:check": "node scripts/check-anthropic-docs.mjs",
    "radar:discover": "node --experimental-strip-types scripts/change-radar/cli.ts discover",
    "radar:sync": "node --experimental-strip-types scripts/change-radar/cli.ts sync",
    "radar:test-fixtures": "vitest run tests/change-radar",
    "radar:report": "node --experimental-strip-types scripts/change-radar/cli.ts report",
    "radar:validate": "node --experimental-strip-types scripts/change-radar/cli.ts validate",
    "validate:phase3": "npm run lint && npm run typecheck && npm test && npm run radar:test-fixtures && npm run radar:validate && npm run build && npm run test:e2e",
    "validate:phase3b": "npm run lint && npm run typecheck && npm test && npm run test:foundry && npm run radar:test-fixtures && npm run radar:validate && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "lucide-react": "1.39.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
